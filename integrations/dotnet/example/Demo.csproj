<!--
  A complete example: every setting XPack.Build has, each with a note on what
  it does. Build it with the steps in README.md beside this file.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================== the application -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XPackDemo</AssemblyName>

    <!-- What users see, taken by XPack.Build as they are: the name, the
         version (SemVer: 1.0.0, 1.1.0-beta.1), the publisher, a description. -->
    <Product>xPack DotNet Demo</Product>
    <Version>1.0.0</Version>
    <Company>Example Ltd</Company>
    <Description>A console application packaged, installed and updated by xPack</Description>

    <!-- The one setting .NET has no word for, and the one that turns
         XPack.Build on: the identity installations know their updates by.
         Never change it once released. -->
    <XPackId>com.example.dotnetdemo</XPackId>
  </PropertyGroup>

  <!-- ================================================== how it starts -->

  <PropertyGroup>
    <!-- A console tool: its shortcut opens a terminal. A window (WinExe, WPF,
         Windows Forms) would not; Avalonia or MAUI built as Exe should say
         false here. -->
    <XPackTerminal>true</XPackTerminal>

    <!-- A name to type in a terminal once installed. The installer offers to
         add it to the command line, and with it the application starts in
         the directory it was typed in, so paths given to it mean what the
         user meant (XPackKeepWorkingDirectory, on by default with a command). -->
    <XPackCommand>xpack-dotnet-demo</XPackCommand>

    <!-- Keep one copy running for each user: a second start hands over to the
         first. Off for a command-line tool. -->
    <XPackSingleInstance>false</XPackSingleInstance>
  </PropertyGroup>

  <!-- Arguments every start is given, before the ones the user types. -->
  <ItemGroup>
    <XPackArgument Include="--greeting=hello" />
  </ItemGroup>

  <!-- ========================================= the desktop and branding -->

  <PropertyGroup>
    <!-- A Start Menu entry, a ~/Applications bundle or a .desktop file. -->
    <XPackShortcut>true</XPackShortcut>

    <!-- One icon per platform, in the format its desktop reads. The one for
         the platform being published goes into the package; the entry, the
         installer and the wizard all show it. ApplicationIcon also gives the
         Windows .exe its icon. -->
    <ApplicationIcon>icons/windows/icon.ico</ApplicationIcon>
    <XPackIconWindows>icons/windows/icon.ico</XPackIconWindows>
    <XPackIconMacos>icons/macos/icon.icns</XPackIconMacos>
    <XPackIconLinux>icons/linux/icon.png</XPackIconLinux>
  </PropertyGroup>

  <!-- ================================================== updating -->

  <PropertyGroup>
    <!-- Where installed copies look for updates; {platform} becomes the one
         published, e.g. windows-x64. Serve bin/xpack/site/ there. HTTPS only,
         except 127.0.0.1, which README.md uses to try it. -->
    <XPackUpdateUrl>https://updates.example.com/xpack-dotnet-demo/{platform}</XPackUpdateUrl>
    <XPackUpdateChannel>stable</XPackUpdateChannel>

    <!-- A release, as opposed to a package: -p:XPackRelease=true builds deltas
         from the earlier releases in XPackPreviousPackages and the update index.

    <XPackPreviousPackages>$(HOME)/xpack-dotnet-demo/releases</XPackPreviousPackages>
    <XPackDeltaCount>3</XPackDeltaCount>
    <XPackPackageUrl>https://github.com/example/demo/releases/download/v$(Version)</XPackPackageUrl>
    <XPackReleaseNotes>https://example.com/demo/releases/$(Version)</XPackReleaseNotes>
    <XPackRollout>10</XPackRollout>
    -->
  </PropertyGroup>

  <!-- ================================================== the installer -->

  <PropertyGroup>
    <!-- What the wizard shows: pages, the licence, two lines of wording. -->
    <XPackInstallerUi>installer-ui.json</XPackInstallerUi>

    <!-- On Windows, the console installer, for installers only scripts run. -->
    <XPackInstallerConsole>false</XPackInstallerConsole>

    <!-- Sign Setup.exe with your code-signing certificate, so Windows names
         you instead of an unknown publisher. Never stops the build.

    <XPackWindowsSignCommand>signtool sign /fd sha256 /tr http://timestamp.digicert.com /td sha256 /f cert.pfx {file}</XPackWindowsSignCommand>
    -->

    <!-- An installer for another platform than this machine's: the folder of
         xPack's release for it.

    <XPackTargetBinaries>$(HOME)/xpack/xpack-0.9.0-linux-x64</XPackTargetBinaries>
    -->
  </PropertyGroup>

  <!-- ================================================== XPack.Build -->

  <ItemGroup>
    <PackageReference Include="XPack.Build" Version="$(XPackBuildVersion)" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The XPack.Build to use; README.md packs one from this repository. -->
    <XPackBuildVersion Condition="'$(XPackBuildVersion)' == ''">0.9.0</XPackBuildVersion>
  </PropertyGroup>

</Project>
