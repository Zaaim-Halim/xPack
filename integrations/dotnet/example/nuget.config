<?xml version="1.0" encoding="utf-8"?>
<!-- XPack.Build from ../feed, where README.md packs it from this repository,
     and everything else from nuget.org. Packages are kept in packages/ here,
     so packing XPack.Build again is never shadowed by an older copy in the
     machine-wide cache: delete packages/ and restore. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <add key="xpack-local" value="../feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
